diff --git a/src/main/archives.c b/src/main/archives.c
index d7279e1..1ca23db 100644
--- a/src/main/archives.c
+++ b/src/main/archives.c
@@ -28,6 +28,7 @@
 #include <sys/types.h>
 #include <sys/time.h>
 #include <sys/stat.h>
+#include <sys/xattr.h>
 
 #include <errno.h>
 #include <string.h>
@@ -527,6 +528,32 @@ tarobject_set_se_context(const char *matchpath, const char *path, mode_t mode)
   dpkg_selabel_set_context(matchpath, path, mode);
 }

+static void
+tarobject_set_pax_data(const char *path, struct pax_data *pd)
+{
+	size_t i;
+	const char *key;
+	const char *prefix = "SCHILY.xattr.";
+	size_t prefix_len = strlen(prefix);
+
+	if (!pd)
+		return;
+
+	for (i = 0; i < pd->num_entries; i++) {
+		key = pd->entries[i].key;
+		if (strncmp(key, prefix, prefix_len) == 0) {
+			const char *xattr_name = key + prefix_len;
+			if (lsetxattr(path, xattr_name,
+			              pd->entries[i].value,
+			              pd->entries[i].value_len, 0) < 0) {
+				if (errno != EOPNOTSUPP && errno != ENOTSUP)
+					warning(_("cannot set xattr '%s' on '%s': %s"),
+					        xattr_name, path, strerror(errno));
+			}
+		}
+	}
+}
+
 static void
 tarobject_matches(struct tarcontext *tc,
                   const char *fn_old, struct stat *stab, char *oldhash,
@@ -1004,6 +1031,7 @@ tarobject(struct tar_archive *tar, struct tar_entry *ti)
