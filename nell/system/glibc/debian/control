Build-Depends: debhelper-compat (= 13), build-essential, git, gawk, pkg-config, bison, python3, linux-libc-dev

Package: glibc-ld
Architecture: amd64
Depends: ${misc:Depends}
Description: GNU C Library x86-64 dynamic loader
 ELF interpreter for 64-bit programs.

Package: glibc-libc
Architecture: amd64
Depends: ${misc:Depends}, glibc-ld (= ${binary:Version})
Description: GNU C Library shared library libc.so.6
 Installs libc.so.6 for x86-64.

Package: glibc-math
Architecture: amd64
Depends: ${misc:Depends}, glibc-libc (= ${binary:Version}), glibc-ld (= ${binary:Version})
Description: GNU C Library mathematical shared objects
 Mathematical and vector mathematical functions in libm.so.6 and libmvec.so.1.

Package: glibc-libnsl
Architecture: amd64
Depends: ${misc:Depends}, glibc-libc (= ${binary:Version})
Description: GNU C Library shared library libnsl.so.1
 Installs libnsl.so.1 for x86-64.

Package: glibc-libnss
Architecture: amd64
Depends: ${misc:Depends}, glibc-libc (= ${binary:Version}), glibc-libresolv (= ${binary:Version})
Description: GNU C Library NSS modules
 Name Service Switch modules for compatibility, databases, DNS, files and Hesiod.

Package: glibc-libresolv
Architecture: amd64
Depends: ${misc:Depends}, glibc-libc (= ${binary:Version})
Description: GNU C Library shared library libresolv.so.2
 Installs libresolv.so.2 for x86-64.

Package: glibc-compat
Architecture: amd64
Depends: ${misc:Depends}, glibc-libc (= ${binary:Version})
Description: GNU C Library ABI compatibility shared objects
 Legacy libanl, libBrokenLocale, libdl, libpthread, librt and libutil
 shared objects, preserved for existing binary dependencies.

Package: glibc-debug
Architecture: amd64
Depends: ${misc:Depends}, glibc-libc (= ${binary:Version}), glibc-ld (= ${binary:Version})
Description: GNU C Library debugging and profiling shared objects
 malloc debugging, memory and program counter profiling, and thread
 debugging support shared libraries.

Package: glibc-gconv
Architecture: amd64
Depends: ${misc:Depends}, glibc-libc (= ${binary:Version})
Description: GNU C Library character conversion modules
 NELL glibc component package.

Package: glibc-audit
Architecture: amd64
Depends: ${misc:Depends}, glibc-libc (= ${binary:Version})
Description: GNU C Library audit library
 NELL glibc component package.

Package: glibc-runtime
Architecture: amd64
Depends: ${misc:Depends}, glibc-ld (= ${binary:Version}), glibc-libc (= ${binary:Version}), glibc-math (= ${binary:Version}), glibc-libnsl (= ${binary:Version}), glibc-compat (= ${binary:Version}), glibc-debug (= ${binary:Version}), glibc-libnss (= ${binary:Version}), glibc-libresolv (= ${binary:Version}), glibc-gconv (= ${binary:Version}), glibc-audit (= ${binary:Version})
Description: GNU C Library complete runtime metapackage
 Dependency-only package assembling individual NELL glibc libraries.

